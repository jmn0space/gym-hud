# Select settings module explicitly for deployments.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ENV=production

# Generate a unique random value with at least 50 characters.
DJANGO_SECRET_KEY=

# Comma-separated public hostnames only (no localhost/wildcards in production).
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Neon pooled PostgreSQL connection string, including sslmode=require.
DATABASE_URL=

# Optional Gunicorn tuning.
GUNICORN_WORKERS=2

# Optional: how long a signed-in session lasts, in seconds (default 30 days).
DJANGO_SESSION_COOKIE_AGE=2592000

# Optional: login endpoint rate limit, DRF "count/period" syntax (default 10/min).
DJANGO_LOGIN_THROTTLE_RATE=10/min

# Provisioning the single application account (`manage.py ensure_app_user`)
# reads DJANGO_APP_USERNAME/DJANGO_APP_PASSWORD from the environment, but
# deliberately NOT from this file: a persisted .env is the wrong place for
# an admin password to sit in plaintext on the host. Export them in your
# shell only for the one command that needs them; see the README's
# "Provisioning the application account" section.
