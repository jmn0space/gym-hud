# Copy to frontend/.env.local for local overrides. Never put secrets here:
# VITE_* values are compiled into the public client bundle.

# API origin prefix. Leave empty for same-origin requests (recommended): the Vite
# dev server proxies /api, and production serves the app from Django.
VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://127.0.0.1:8000
